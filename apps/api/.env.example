# Copy to .env for local development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Local Postgres from docker-compose.yml (`pnpm db:up` in the repo root).
DATABASE_URL=postgresql://shoppy:shoppy@localhost:5442/shoppy

# Signs access tokens. Any random string of 32+ characters (`openssl rand -hex 32`).
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789

# Where links in emails point to.
APP_URL=http://localhost:5180

# Optional
SENTRY_DSN=
# Without it, emails are written to the log instead of being sent (the links are clickable there).
RESEND_API_KEY=
# OAuth web client ID for Sign in with Google (docs/06-infrastructure.md). Without it, the Google button is hidden.
GOOGLE_CLIENT_ID=
# When set, every request must carry `x-shoppy-proxy-secret` with this value (set in production by the Cloudflare Worker).
PROXY_SECRET=
