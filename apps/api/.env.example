# Copy to .env for local development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Local Postgres from docker-compose.yml (`pnpm db:up` in the repo root).
DATABASE_URL=postgresql://shoppy:shoppy@localhost:5442/shoppy

# Optional
SENTRY_DSN=
# When set, every request must carry `x-shoppy-proxy-secret` with this value (set in production by the Cloudflare Worker).
PROXY_SECRET=
