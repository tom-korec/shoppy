{
  "name": "@shoppy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate --no-hints",
    "build": "prisma generate --no-hints && nest build",
    "dev": "nest start --watch",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nestjs": "^11.2.0",
    "@shoppy/shared": "workspace:^",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^12.1.2",
    "@shoppy/config": "workspace:^",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
