// Data model: see docs/03-architecture.md §3.6.
// Models are added phase by phase.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  listsGrouped    Boolean   @default(true) @map("lists_grouped")
  listsSort       ListSort  @default(ACTIVITY) @map("lists_sort")

  identities       AuthIdentity[]
  sessions         SessionFamily[]
  emailTokens      EmailToken[]
  categories       Category[]
  items            Item[]            @relation("ItemOwner")
  itemsCreated     Item[]            @relation("ItemCreator")
  lists            List[]            @relation("ListOwner")
  listsCreated     List[]            @relation("ListCreator")
  entriesAdded     ListEntry[]       @relation("EntryAddedBy")
  entriesChecked   ListEntry[]       @relation("EntryCheckedBy")
  purchases        PurchaseRecord[]
  householdMembers HouseholdMember[]
  invitations      Invitation[]
  listPositions    ListPosition[]

  @@map("users")
}

enum ListSort {
  ACTIVITY
  CREATED
  CUSTOM

  @@map("list_sort")
}

enum AuthProvider {
  GOOGLE

  @@map("auth_provider")
}

model AuthIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model SessionFamily {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  currentTokenHash  String    @map("current_token_hash")
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz
  userAgent         String?   @map("user_agent")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session_families")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("email_token_purpose")
}

model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz
  usedAt    DateTime?         @map("used_at") @db.Timestamptz
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("household_role")
}

model Household {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members     HouseholdMember[]
  invitations Invitation[]
  categories  Category[]
  items       Item[]
  lists       List[]

  @@map("households")
}

// Exactly one OWNER per household (partial unique index in the migration).
model HouseholdMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz

  household Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides MemberPermissionOverride[]

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model MemberPermissionOverride {
  memberId   String  @map("member_id") @db.Uuid
  permission String
  isGranted  Boolean @map("is_granted")

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, permission])
  @@map("member_permission_overrides")
}

enum InvitationKind {
  LINK
  CODE
  EMAIL

  @@map("invitation_kind")
}

// Secrets (link token, code) are stored hashed. An EMAIL invitation also carries a link token
// for the emailed join link.
model Invitation {
  id          String         @id @default(uuid(7)) @db.Uuid
  householdId String         @map("household_id") @db.Uuid
  kind        InvitationKind
  tokenHash   String?        @unique @map("token_hash")
  codeHash    String?        @unique @map("code_hash")
  email       String?        @db.Citext
  role        HouseholdRole
  maxUses     Int?           @map("max_uses")
  usedCount   Int            @default(0) @map("used_count")
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz
  revokedAt   DateTime?      @map("revoked_at") @db.Timestamptz
  declinedAt  DateTime?      @map("declined_at") @db.Timestamptz
  createdById String?        @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([email])
  @@index([createdById])
  @@map("invitations")
}

// Categories, items and lists belong to exactly one scope: a user or a household
// (CHECK constraints in the migration, docs/03-architecture.md §3.6).
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  householdId String?  @map("household_id") @db.Uuid
  name        String
  icon        String
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner     User?       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  household Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     Item[]
  entries   ListEntry[]

  @@index([ownerUserId, position])
  @@index([householdId, position])
  @@map("categories")
}

model Item {
  id          String   @id @default(uuid(7)) @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  householdId String?  @map("household_id") @db.Uuid
  name        String
  description String?
  categoryId  String?  @map("category_id") @db.Uuid
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner     User?            @relation("ItemOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  household Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("ItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  entries   ListEntry[]
  purchases PurchaseRecord[]

  @@index([ownerUserId])
  @@index([householdId])
  @@index([categoryId])
  @@index([createdById])
  @@map("items")
}

model List {
  id             String    @id @default(uuid(7)) @db.Uuid
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  householdId    String?   @map("household_id") @db.Uuid
  name           String
  icon           String
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  owner     User?            @relation("ListOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  household Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("ListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries   ListEntry[]
  purchases PurchaseRecord[]
  positions ListPosition[]

  @@index([ownerUserId])
  @@index([householdId])
  @@index([createdById])
  @@map("lists")
}

// An entry references a catalog item, or is a one-time entry with its own text and
// optional category (CHECK constraints in the migration).
model ListEntry {
  id          String    @id @default(uuid(7)) @db.Uuid
  listId      String    @map("list_id") @db.Uuid
  itemId      String?   @map("item_id") @db.Uuid
  text        String?
  categoryId  String?   @map("category_id") @db.Uuid
  note        String?
  checkedAt   DateTime? @map("checked_at") @db.Timestamptz
  checkedById String?   @map("checked_by") @db.Uuid
  addedById   String?   @map("added_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  list      List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  checkedBy User?     @relation("EntryCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  addedBy   User?     @relation("EntryAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([listId, id])
  @@index([itemId])
  @@index([categoryId])
  @@index([checkedById])
  @@index([addedById])
  @@map("list_entries")
}

model PurchaseRecord {
  id               String   @id @default(uuid(7)) @db.Uuid
  listId           String   @map("list_id") @db.Uuid
  itemId           String?  @map("item_id") @db.Uuid
  nameSnapshot     String   @map("name_snapshot")
  categorySnapshot String?  @map("category_snapshot")
  note             String?
  boughtById       String?  @map("bought_by") @db.Uuid
  boughtAt         DateTime @map("bought_at") @db.Timestamptz

  list     List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  item     Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  boughtBy User? @relation(fields: [boughtById], references: [id], onDelete: SetNull)

  @@index([listId, boughtAt(sort: Desc), id(sort: Desc)])
  @@index([itemId])
  @@index([boughtById])
  @@map("purchase_records")
}

// A user's own order of the lists they can see (Lists screen, "custom" sort).
model ListPosition {
  userId   String @map("user_id") @db.Uuid
  listId   String @map("list_id") @db.Uuid
  position Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
  @@index([listId])
  @@map("list_positions")
}
